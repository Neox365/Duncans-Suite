#include <windows.h>

// Manifest (DPI-Awareness, OS-Kompatibilitaet)
1 RT_MANIFEST "suite.manifest"

// Anwendungs-Icon
1 ICON "suite.ico"

VS_VERSION_INFO VERSIONINFO
FILEVERSION 1,1,16,0
PRODUCTVERSION 1,1,16,0
FILEOS VOS_NT_WINDOWS32
FILETYPE VFT_APP
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040704B0"
        BEGIN
            VALUE "CompanyName", "Duncan"
            VALUE "FileDescription", "Duncan's Suite"
            VALUE "FileVersion", "1.1.16"
            VALUE "InternalName", "DuncansSuite"
            VALUE "OriginalFilename", "DuncansSuite.exe"
            VALUE "ProductName", "Duncan's Suite"
            VALUE "ProductVersion", "1.1.16"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x0407, 1200
    END
END
