#include <windows.h>

// Manifest (DPI-Awareness, OS-Kompatibilitaet)
1 RT_MANIFEST "docs.manifest"

// Anwendungs-Icon (vorlaeufig das Suite-Icon)
1 ICON "suite.ico"

VS_VERSION_INFO VERSIONINFO
FILEVERSION 0,3,1,0
PRODUCTVERSION 0,3,1,0
FILEOS VOS_NT_WINDOWS32
FILETYPE VFT_APP
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040704B0"
        BEGIN
            VALUE "CompanyName", "Duncan"
            VALUE "FileDescription", "Oggys Docs-Files"
            VALUE "FileVersion", "0.3.1"
            VALUE "InternalName", "OggysDocsFiles"
            VALUE "OriginalFilename", "OggysDocsFiles.exe"
            VALUE "ProductName", "Oggys Docs-Files"
            VALUE "ProductVersion", "0.3.1"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x0407, 1200
    END
END
